  "grammar_patterns": [
    {
      "pattern": "This is my [family member].",
      "examples": [
        "This is my sister.",
        "This is my brother.",
        "This is my cousin."
      ]
    },
    {
      "pattern": "[Name] is my [family member].",
      "examples": [
        "Amy is my sister.",
        "Max is my brother.",
        "Leo is my cousin."
      ]
    },
    {
      "pattern": "I have [number] [family members].",
      "examples": [
        "I have two cousins.",
        "I have an aunt and an uncle.",
        "We have a big family."
      ]
    },
    {
      "pattern": "[Plural noun] are [comparative] than [plural noun].",
      "examples": [
        "Giraffes are taller than lions.",
        "Cows are bigger than goats.",
        "Horses are faster than sheep."
      ]
    },
    {
      "pattern": "The [noun] is [comparative] than the [noun].",
      "examples": [
        "The red car is bigger than the blue car.",
        "The green car is faster than the red car.",
        "The elephant is bigger than the monkey."
      ]
    },
    {
      "pattern": "When is your birthday? My birthday is in [month].",
      "examples": [
        "When is your birthday? My birthday is in June.",
        "My birthday is in March.",
        "My favorite month is December."
      ]
    },
    {
      "pattern": "How old are you? I'm [number].",
      "examples": [
        "How old are you? I'm nine.",
        "I'm seven.",
        "She's seven."
      ]
    },
    {
      "pattern": "[Subject] was/were [adjective].",
      "examples": [
        "It was sunny.",
        "The children were happy.",
        "Mom was hot and Dad was tired."
      ]
    }
  ],
  "key_sentences": [

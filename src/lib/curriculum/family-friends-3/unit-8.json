  "grammar_patterns": [
    {
      "pattern": "I'd like a/an [countable noun].",
      "examples": [
        "I'd like a melon.",
        "Edward would like a sandwich.",
        "She would like an apple."
      ]
    },
    {
      "pattern": "We'd like some [uncountable or plural noun].",
      "examples": [
        "We'd like some noodles.",
        "We'd like ice cream!",
        "The children would like some pastries."
      ]
    },
    {
      "pattern": "Would you like some [noun]? Yes, please. / No, thanks.",
      "examples": [
        "Would you like some cereal? Yes, please.",
        "Would you like a banana? No, thanks.",
        "Would your friends like some drinks?"
      ]
    },
    {
      "pattern": "one [noun] / two [plural noun] / some [plural noun]",
      "examples": [
        "one melon, two melons, three melons",
        "some melons",
        "an apple and some oranges"
      ]
    },
    {
      "pattern": "some [uncountable noun]",
      "examples": [
        "some bread",
        "some rice and some water",
        "some salad and some milkshake"
      ]
    },
    {
      "pattern": "We need some [noun].",
      "examples": [
        "We need some noodles and some bread.",
        "We need a lot of things today.",
        "Can you get me some onions and a cucumber, please?"
      ]
    },
    {
      "pattern": "You need [quantity] [noun].",
      "examples": [
        "You need two big potatoes.",
        "You need a piece of fish.",
        "You need some salt and pepper."
      ]
    }
  ],

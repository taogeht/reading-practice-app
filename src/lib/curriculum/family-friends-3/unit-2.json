  "grammar_patterns": [
    {
      "pattern": "I like [verb]-ing.",
      "examples": [
        "I like reading.",
        "I like playing chess.",
        "I like fishing now!"
      ]
    },
    {
      "pattern": "I don't like [verb]-ing.",
      "examples": [
        "I don't like fishing.",
        "I don't like taking photos.",
        "I don't like skateboarding."
      ]
    },
    {
      "pattern": "He/She likes [verb]-ing.",
      "examples": [
        "He likes playing chess.",
        "She likes painting.",
        "Dad likes taking photos."
      ]
    },
    {
      "pattern": "He/She doesn't like [verb]-ing.",
      "examples": [
        "He doesn't like skateboarding.",
        "She doesn't like playing basketball.",
        "Lee doesn't like fishing."
      ]
    },
    {
      "pattern": "Do you like [verb]-ing? Yes, I do. / No, I don't.",
      "examples": [
        "Do you like playing chess? Yes, I do.",
        "Do you like fishing? No, I don't.",
        "Do you like reading comics? Yes, I do."
      ]
    },
    {
      "pattern": "Does he/she like [verb]-ing? Yes, he does. / No, he doesn't.",
      "examples": [
        "Does he like fishing? Yes, he does.",
        "Does he like skateboarding? No, he doesn't.",
        "Does he like playing chess? Yes, he does."
      ]
    },
    {
      "pattern": "[Name] likes/doesn't like [verb]-ing.",
      "examples": [
        "Janet loves playing volleyball, but she doesn't like playing basketball.",
        "Lisa likes taking photos.",
        "Lee doesn't like fishing. He likes skateboarding."
      ]
    }
  ],
  "phonics": {
    "sound": "magic e",
    "description": "Magic e makes the vowel say its long sound: a_e, i_e, o_e, u_e.",
    "word_families": [
      { "family": "a_e", "words": [{ "word": "face" }, { "word": "space" }] },
      { "family": "i_e", "words": [{ "word": "kite" }, { "word": "bike" }] },
      { "family": "o_e", "words": [{ "word": "rope" }, { "word": "stone" }] },
      { "family": "u_e", "words": [{ "word": "June" }, { "word": "cube" }] }
    ],
    "chant": [

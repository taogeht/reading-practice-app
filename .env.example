# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/recording_homework_app"

# Authentication is database-backed and uses opaque session credentials. There
# is no shared authentication secret in the current implementation.

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="reading-practice-audio"
R2_PUBLIC_URL="https://your-r2-public-url.com"

# Google Cloud Text-to-Speech
GOOGLE_TTS_PROJECT_ID="your-gcp-project-id"
GOOGLE_TTS_CLIENT_EMAIL="service-account@your-project.iam.gserviceaccount.com"
GOOGLE_TTS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"

# Anthropic (Sunny homework helper)
ANTHROPIC_API_KEY="sk-ant-..."

# Hetzner Experiments Platform Inference API (OpenAI-compatible, free while
# experimental). Only needed when the `text.generationModel` system setting is
# switched to "hetzner-qwen"; Claude is the default and needs none of this.
# HETZNER_INFERENCE_MODEL is optional — set it from the /v1/models response if
# the default model id is retired.
HETZNER_INFERENCE_TOKEN=""
HETZNER_INFERENCE_MODEL="Qwen/Qwen3.6-35B-A3B-FP8"

# OpenAI (Whisper STT for AI-graded recordings; also GPT Image 1 mini when the
# image.generationModel admin setting is set to "gpt-image-1-mini")
OPENAI_API_KEY="sk-..."

# Image generation model fallback. The admin "Image Generation Model" setting
# (System Settings) takes precedence; this env var is only used when that
# setting is unset. Values: "gemini" (default) or "gpt-image-1-mini".
# IMAGE_GEN_MODEL="gemini"

# AI-graded recordings feature flag. Both must be set together:
# - ENABLE_AI_GRADING gates the server (whether the API accepts ai_graded
#   assignments and whether Whisper is called).
# - NEXT_PUBLIC_ENABLE_AI_GRADING gates the client (whether the teacher sees
#   the AI-Graded option in the create-assignment dialog).
# Default to "false" until the feature has been tested with real students.
ENABLE_AI_GRADING="false"
NEXT_PUBLIC_ENABLE_AI_GRADING="false"

# PDF export (printable tests). Path to the Chromium binary puppeteer-core drives.
# Set automatically in the Docker image (Alpine chromium). Leave unset for local
# dev on macOS — it auto-resolves to the installed Google Chrome. Override only if
# a future Alpine moves the binary (e.g. /usr/bin/chromium).
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional live mobile-auth smoke test. Use a dedicated test learner because the
# script creates and then revokes native refresh sessions.
# MOBILE_TEST_API_URL="https://your-deployed-app.example.com"
# MOBILE_TEST_LOGIN_TOKEN="dedicated-test-learner-login-token"
# MOBILE_TEST_PLATFORM="ios"

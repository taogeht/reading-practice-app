{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@starling-rise/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
